msgstr "Texto del lanzador"

msgid "Suggested questions"
msgstr "Preguntas sugeridas"

msgid "One per line. They appear as buttons before the first question."
msgstr "Una por línea. Aparecen como botones antes de la primera pregunta."

msgid "Notice (footer)"
msgstr "Aviso (pie)"

msgid "Custom CSS"
msgstr "CSS personalizado"

msgid "Useful variables: --saic-primary, --saic-bg, --saic-fg, --saic-radius, --saic-font, --saic-height, --saic-user-bg, --saic-bot-bg."
msgstr "Variables útiles: --saic-primary, --saic-bg, --saic-fg, --saic-radius, --saic-font, --saic-height, --saic-user-bg, --saic-bot-bg."

