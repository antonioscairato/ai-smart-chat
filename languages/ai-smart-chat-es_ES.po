msgstr "Project-Id-Version: AI Smart Chat 1.3.5\nLanguage: es_ES\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\nX-Domain: ai-smart-chat\n"

msgid "AI-powered search chatbot (RAG) for your site: answers visitors' questions from your published content and cites the sources."
msgstr "Chatbot de búsqueda con IA (RAG) para tu sitio: responde a las preguntas de los visitantes a partir de tu contenido publicado y cita las fuentes."

msgid "Settings"
msgstr "Configuración"

msgid "Help"
msgstr "Ayuda"

msgid "Index"
msgstr "Índice"

msgid "Extra sources"
msgstr "Fuentes adicionales"

msgid "History"
msgstr "Historial"

msgid "Indexing…"
msgstr "Indexando…"

#, php-format
msgid "Indexing… %1$d/%2$d (%3$d indexed, %4$d unchanged)"
msgstr "Indexando… %1$d/%2$d (%3$d indexados, %4$d sin cambios)"

#, php-format
msgid "Done. %1$d indexed, %2$d unchanged, %3$d removed."
msgstr "Hecho. %1$d indexados, %2$d sin cambios, %3$d eliminados."

msgid "Remove the entire index? You will need to reindex before the chat can answer again."
msgstr "¿Eliminar todo el índice? Tendrás que reindexar para que el chat vuelva a responder."

msgid "Loading…"
msgstr "Cargando…"

msgid "Enter a CSS selector."
msgstr "Introduce un selector CSS."

msgid "Testing…"
msgstr "Probando…"

msgid "Request failed."
msgstr "Falló la solicitud."

msgid "Permission denied."
msgstr "Sin permiso."

#, php-format
msgid "Connection OK. Embeddings have %1$d dimensions; model reply: \"%2$s\"."
msgstr "Conexión correcta. Los embeddings tienen %1$d dimensiones; respuesta del modelo: \"%2$s\"."

msgid "AI API"
msgstr "API de IA"

msgid "API key"
msgstr "Clave de API"

msgid "Defined in wp-config.php (SAIC_OPENAI_API_KEY)."
msgstr "Definida en wp-config.php (SAIC_OPENAI_API_KEY)."

msgid "•••••• (saved — leave blank to keep)"
msgstr "•••••• (guardada — déjalo en blanco para mantenerla)"

msgid "Remove saved key"
msgstr "Eliminar la clave guardada"

msgid "Recommended: define <code>define( 'SAIC_OPENAI_API_KEY', 'sk-...' );</code> in wp-config.php so the key is not stored in the database."
msgstr "Recomendado: define <code>define( 'SAIC_OPENAI_API_KEY', 'sk-...' );</code> en wp-config.php para no guardar la clave en la base de datos."

msgid "Base URL"
msgstr "URL base"

msgid "OpenAI default. Works with any compatible API (Azure, OpenRouter, Ollama/LM Studio via proxy, etc.). HTTPS is required in production."
msgstr "Valor predeterminado de OpenAI. Sirve para cualquier API compatible (Azure, OpenRouter, Ollama/LM Studio mediante proxy, etc.). Requiere HTTPS en producción."

msgid "Embeddings model"
msgstr "Modelo de embeddings"

msgid "When you change the model or the dimensions, run a full (forced) reindex."
msgstr "Si cambias el modelo o las dimensiones, haz una reindexación completa (forzada)."

msgid "Embedding dimensions"
msgstr "Dimensiones de los embeddings"

msgid "0 = model default. Smaller values (e.g. 512) make search faster and the database smaller, on models that support it."
msgstr "0 = valor predeterminado del modelo. Valores menores (p. ej., 512) hacen la búsqueda más rápida y la base de datos más pequeña, en los modelos que lo admiten."

msgid "Chat model"
msgstr "Modelo de chat"

msgid "Check your provider's documentation for the models available today."
msgstr "Consulta la documentación de tu proveedor para ver los modelos disponibles hoy."

msgid "Temperature"
msgstr "Temperatura"

msgid "Leave empty to not send the parameter (required by some reasoning models)."
msgstr "Déjalo vacío para no enviar el parámetro (necesario en algunos modelos de razonamiento)."

msgid "Reasoning effort"
msgstr "Esfuerzo de razonamiento"

msgid "Optional. Sent as reasoning_effort to reasoning models; \"low\" is usually enough for Q&A about your content and is cheaper and faster. Leave empty to not send it (required for models that do not support it). Accepted values depend on the model."
msgstr "Opcional. Se envía como reasoning_effort a los modelos de razonamiento; \"low\" suele bastar para preguntas y respuestas sobre tu contenido y es más barato y rápido. Déjalo vacío para no enviarlo (necesario en modelos que no lo admiten). Los valores aceptados dependen del modelo."

msgid "Max output tokens"
msgstr "Máximo de tokens de salida"

msgid "0 = do not send. For reasoning models the reasoning tokens count toward this limit, so keep it generous or answers may come back empty."
msgstr "0 = no enviar. En los modelos de razonamiento, los tokens de razonamiento cuentan para este límite; déjalo holgado o las respuestas podrían salir vacías."

msgid "Test"
msgstr "Probar"

msgid "Test connection (save first)"
msgstr "Probar conexión (guarda antes)"

msgid "Indexed content"
msgstr "Contenido indexado"

msgid "Content types"
msgstr "Tipos de contenido"

msgid "Posts, pages, products (WooCommerce), events and any public custom post type. Only published, non-password-protected content is indexed."
msgstr "Entradas, páginas, productos (WooCommerce), eventos y cualquier tipo de contenido personalizado público. Solo se indexa el contenido publicado y sin contraseña."

msgid "Extra custom fields"
msgstr "Campos personalizados adicionales"

msgid "One meta_key per line, added to the indexed text (useful for event dates/venues and ACF fields)."
msgstr "Un meta_key por línea, añadido al texto indexado (útil para fechas y lugares de eventos y campos de ACF)."

msgid "Automatic reindexing"
msgstr "Reindexación automática"

msgid "Update the index when content is created, edited or deleted (in the background, via WP-Cron)"
msgstr "Actualizar el índice al crear, editar o eliminar contenido (en segundo plano, mediante WP-Cron)"

msgid "Unchecked = manual only, from the Index tab or WP-CLI."
msgstr "Desmarcado = solo manual, desde la pestaña Índice o con WP-CLI."

msgid "Chunk size"
msgstr "Tamaño del fragmento"

msgid "characters"
msgstr "caracteres"

msgid "Overlap"
msgstr "Solapamiento"

msgid "Answers"
msgstr "Respuestas"

msgid "Chunks per question (top-k)"
msgstr "Fragmentos por pregunta (top-k)"

msgid "Items for list questions"
msgstr "Elementos para preguntas de lista"

msgid "For questions such as \"list all products\", how many different pages are sent to the chat (one excerpt per page). 0 = disable."
msgstr "Para preguntas como \"enumera todos los productos\", cuántas páginas distintas se envían al chat (un fragmento por página). 0 = desactivar."

msgid "Minimum similarity"
msgstr "Similitud mínima"

msgid "From 0 to 1. Chunks below this are ignored; if none pass, the chat replies with the \"not found\" message without calling the chat model."
msgstr "De 0 a 1. Los fragmentos por debajo se ignoran; si ninguno lo supera, el chat responde con el mensaje de \"no encontrado\" sin llamar al modelo de chat."

msgid "Sources shown"
msgstr "Fuentes mostradas"

msgid "Used when the model does not explicitly cite any source."
msgstr "Se usa cuando el modelo no cita ninguna fuente de forma explícita."

msgid "History messages"
msgstr "Mensajes del historial"

msgid "How many previous messages accompany the question (0 = no conversation memory)."
msgstr "Cuántos mensajes anteriores acompañan a la pregunta (0 = sin memoria de conversación)."

msgid "System prompt"
msgstr "Prompt del sistema"

msgid "Variables: {site_name}, {site_url}. Empty = default."
msgstr "Variables: {site_name}, {site_url}. Vacío = valor predeterminado."

msgid "Message when there is no answer"
msgstr "Mensaje cuando no hay respuesta"

msgid "Interface"
msgstr "Interfaz"

msgid "Default template"
msgstr "Plantilla predeterminada"

msgid "To customize the HTML/CSS, copy the template folder to <code>your-theme/ai-smart-chat/&lt;template&gt;/</code>. See the Help page."
msgstr "Para personalizar el HTML/CSS, copia la carpeta de la plantilla a <code>tu-tema/ai-smart-chat/&lt;plantilla&gt;/</code>. Consulta la página Ayuda."

