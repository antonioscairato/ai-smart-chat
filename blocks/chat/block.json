{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ai-site-chat/chat",
	"title": "AI Smart Chat",
	"category": "widgets",
	"icon": "format-chat",
	"description": "AI-powered search chatbot based on your site content.",
	"keywords": ["chat", "ai", "search", "assistant"],
	"textdomain": "ai-smart-chat",
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	},
	"attributes": {
		"template": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"placeholder": { "type": "string", "default": "" },
		"welcome": { "type": "string", "default": "" },
		"height": { "type": "string", "default": "520px" }
	},
	"editorScript": "saic-block-editor"
}
